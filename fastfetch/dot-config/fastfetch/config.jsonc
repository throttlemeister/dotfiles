// "Hanabi" (KDE Next, dark) — fastfetch theme, updated 2026-11-19
// The gecko and the key column share one gradient sampled from the wallpaper:
// deep indigo-violet at the top, through periwinkle and mauve, down to amber.
// A matching horizon line sits under the header. Values stay frost-white;
// percentages and bars turn teal -> amber -> red only when something needs attention.
// No Nerd Font icons needed. 17 rows, fits a ~100x20 terminal.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1        ⣀⣤⣴⣶⣾⣿⣿⣿⣿⣿⣿⣶⣶⣦⣤⣰⣶⣶⣤⣤⣀⡀\n$2    ⢀⣤⣶⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⡿⢩⡤⢍⢷⡀\n$3  ⣠⣾⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣟⠿⣧⡘⠿⢛⣼⣧\n$4 ⣴⣿⣿⠿⠿⠿⠿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣿⣷⣦⣭⣙⣋⣩⡄\n$5⣼⣿⡟⠁⣠⣶⣶⣤⡀⠙⢿⣿⣿⣿⠿⠛⠻⠿⣿⣿⣿⣿⠛⠛⠛⠛⠛⠛⠛⠉⠁\n$6⣿⣿⡁⢸⣿⣁⡈⠹⣿⡆⠈⢿⣿⡇    ⠈⠻⣿⣿\n$7⠘⣿⣷⣄⠙⠛⠋⣠⣿⡇  ⠙⠁      ⠈⠙⠣\n$8 ⠈⠛⠿⣿⣿⣿⠿⠋",
    "color": {
      "1": "#7866AA",
      "2": "#7478C2",
      "3": "#7089D2",
      "4": "#8F7AC0",
      "5": "#9E8FBC",
      "6": "#BE8BAE",
      "7": "#CB8F80",
      "8": "#D99A55"
    },
    "padding": {
      "top": 5,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#948CB8",
      "title": "#E2E0EE",
      "output": "#E2E0EE",
      "separator": "#948CB8"
    },
    "brightColor": false,
    "showErrors": false,
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    },
    "percent": {
      "type": [
        "bar",
        "num",
        "num-color",
        "bar-monochrome"
      ],
      "ndigits": 0,
      "color": {
        "green": "#82B7B8",
        "yellow": "#D99A55",
        "red": "#CC736C"
      }
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "■",
        "total": "■"
      },
      "border": null,
      "color": {
        "total": "#3A3152"
      }
    }
  },
  "modules": [
    {
      "type": "os",
      "key": " ",
      "format": "{#1}{##D99A55}{pretty-name}{#}"
    },
    {
      "type": "host",
      "key": " ",
      "format": "{##948CB8}{family}"
    },
    {
      "type": "custom",
      "format": "{##7866AA}━{##7769AE}━{##776CB2}━{##766EB5}━{##7671B9}━{##7574BC}━{##7476C0}━{##7479C3}━{##737BC5}━{##737EC8}━{##7281CA}━{##7183CC}━{##7186CF}━{##7088D1}━{##7388D1}━{##7886CE}━{##7D84CB}━{##8281C9}━{##867FC6}━{##8A7DC3}━{##8E7AC0}━{##917DBF}━{##9380BF}━{##9683BE}━{##9887BE}━{##9A8ABD}━{##9C8DBD}━{##9F8FBC}━{##A48EBA}━{##A98EB8}━{##AE8DB6}━{##B38DB4}━{##B78CB1}━{##BC8BAF}━{##BF8BAC}━{##C18CA6}━{##C38C9F}━{##C58D99}━{##C78E92}━{##C98E8A}━{##CA8F82}━{##CD907C}━{##CF9277}━{##D19471}━{##D3956B}━{##D59764}━{##D7985D}━{##D99A55}━{#}"
    },
    {
      "type": "kernel",
      "format": "{release}",
      "key": "  kernel  ",
      "keyColor": "#7866AA"
    },
    {
      "type": "disk",
      "folders": "/",
      "format": "{create-time:10} ({days} days)",
      "key": "  os age  ",
      "keyColor": "#776DB3"
    },
    {
      "type": "uptime",
      "key": "󰅐  uptime  ",
      "keyColor": "#7574BC"
    },
    {
      "type": "packages",
      //"format": "{rpm} rpm{?flatpak-all} · {flatpak-all} flatpak{?}",
      "key": "󰏖  pkgs    ",
      "keyColor": "#747AC4"
    },
    {
      "type": "shell",
      "format": "{pretty-name} {version}",
      "key": "  shell   ",
      "keyColor": "#7280CA"
    },
    "break",
    {
      "type": "de",
      "format": "{pretty-name} {version}",
      "key": "  desktop ",
      "keyColor": "#7186D0"
    },
    {
      "type": "lm",
      "format": "{pretty-name}",
      "key": "󰧨  login   ",
      "keyColor": "#7786CE"
    },
    {
      "type": "wm",
      "format": "{pretty-name} · {protocol-name}",
      "key": "  session ",
      "keyColor": "#8381C8"
    },
    {
      "type": "terminal",
      "format": "{pretty-name} {version}",
      "key": "  term    ",
      "keyColor": "#8E7BC1"
    },
    "break",
    {
      "type": "cpu",
      "format": "{name} · {cores-logical} threads",
      "key": "󰻠  cpu     ",
      "keyColor": "#9481BF"
    },
    {
      "type": "gpu",
      "format": "{name}",
      "key": "󰍛  gpu     ",
      "keyColor": "#9989BD"
    },
    {
      "type": "display",
      "key": "󰍹  display ",
      "keyColor": "#A08FBB"
    },
    {
      "type": "memory",
      "format": "{percentage-bar}  {percentage}  {##948CB8}{used} / {total}",
      "key": "󰑭  memory  ",
      "keyColor": "#AC8DB6"
    },
    {
      "type": "disk",
      "folders": "/",
      "format": "{size-percentage-bar}  {size-percentage}  {##948CB8}{size-used} / {size-total}",
      "key": "  root    ",
      "keyColor": "#B88CB1"
    },
    {
      "type": "disk",
      "folders": "/home",
      "format": "{size-percentage-bar}  {size-percentage}  {##948CB8}{size-used} / {size-total}",
      "key": "  home    ",
      "keyColor": "#C08CA8"
    },
    {
      "type": "disk",
      "folders": "/home/throttlemeister/games",
      "format": "{size-percentage-bar}  {size-percentage}  {##948CB8}{size-used} / {size-total}",
      "key": "  games   ",
      "keyColor": "#C58D98"
    },
    {
      "type": "wifi",
      "key": "  wifi    ",
      "format": "{ssid}",
      "keyColor": "#CA8F86"
    },
    {
      "type": "localip",
      "key": "󰩟  lan     ",
      "compact": true,
      "keyColor": "#CF9277"
    },
    {
      "type": "publicip",
      "key": "󰩟  wan     ",
      "keyColor": "#D49667",
      "timeout": 1000
    },
    {
      "type": "battery",
      "format": "{capacity-bar}  {capacity}  {##948CB8}{status}",
      "key": "  power   ",
      "keyColor": "#D99A55"
    }
  ]
}
